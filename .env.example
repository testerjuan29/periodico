# ==============================================================================
# Periódico Automático — variables de entorno
# ==============================================================================
# Copia este archivo a `.env` y llena los valores marcados con <...>
# Después de editar `.env`, recrea el contenedor afectado para que tome los cambios:
#   docker compose up -d --force-recreate n8n
# ==============================================================================


# =========================
# PostgreSQL (shared)
# =========================
POSTGRES_USER=periodico
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=periodico
N8N_DB=n8n


# =========================
# N8N
# =========================
N8N_USER=admin
N8N_PASSWORD=changeme_n8n
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=America/Bogota


# =========================
# WordPress
# =========================
WP_DB_ROOT_PASSWORD=changeme_wp_root
WP_DB_PASSWORD=changeme_wp


# =========================
# Producción (docker-compose.prod.yml) — dominios detrás de Caddy
# Registros A en el DNS apuntando a la IP pública de la VM.
# En desarrollo local estos se ignoran.
# =========================
# BACKOFFICE_DOMAIN=backoffice.tudominio.com
# N8N_DOMAIN=n8n.tudominio.com
# WP_DOMAIN=wp.tudominio.com


# =========================
# Backoffice (Next.js)
# =========================
BACKOFFICE_PUBLIC_URL=http://localhost:3000
# Firma de la cookie de sesión — generar con: openssl rand -base64 32
NEXTAUTH_SECRET=changeme_generate_with_openssl_rand_base64_32
ADMIN_EMAIL=cliente@periodico.com
# Login del backoffice: un solo usuario estático con acceso total.
# El middleware protege todas las páginas y APIs salvo /api/image y
# /api/upload (las consumen n8n y Puppeteer desde la red interna, sin cookies).
ADMIN_USER=editor
ADMIN_PASSWORD=<inventa-una-contraseña-fuerte>
N8N_APPROVAL_WEBHOOK=http://n8n:5678/webhook/publication-approved
# Token compartido n8n → backoffice para subir fotos adjuntas de correo/WhatsApp
# (POST /api/upload/ingest). Generar uno aleatorio, p. ej.: openssl rand -hex 24
UPLOAD_TOKEN=changeme_upload_token


# =========================
# LLM — DeepSeek vía Huawei ModelArts MaaS
# =========================
# Signup: https://console.huaweicloud.com/ → activar servicio ModelArts → suscribirse a DeepSeek
# La key NO es formato `sk-...` de DeepSeek oficial — es un token largo (~90 chars) de Huawei Cloud
DEEPSEEK_API_URL=https://api-ap-southeast-1.modelarts-maas.com/openai/v1
DEEPSEEK_API_KEY=<tu-key-de-huawei-modelarts>
DEEPSEEK_MODEL=DeepSeek-V3.2


# =========================
# WP local — usado por scripts/import_taxonomy.py
# =========================
# Application Password de WP (formato: xxxx xxxx xxxx xxxx xxxx xxxx)
# Se crea desde /wp-admin/profile.php → sección "Contraseñas de aplicación"
# Requiere `WP_ENVIRONMENT_TYPE=local` (ya configurado en docker-compose)
WP_LOCAL_URL=http://localhost:8080
WP_LOCAL_USER=admin
WP_LOCAL_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx


# ==============================================================================
# APIs externas — se pasan al contenedor de N8N vía docker-compose.yml
# ==============================================================================


# =========================
# WhatsApp Business Cloud API — Meta
# =========================
# Signup: https://developers.facebook.com/apps → crear App → agregar producto "WhatsApp"
# Guía completa: docs/guia-integraciones.md#whatsapp-cloud-api
WA_PHONE_NUMBER_ID=<phone-number-id-del-sandbox-de-Meta>
# Verify token (inventa uno, debe coincidir con lo que pongas en Meta → Webhook config)
WA_VERIFY_TOKEN=periodico-verify-2026
# Flag para activar la descarga de imagen adjunta de WhatsApp (paso: lookaside → ImgBB → template).
# Actualmente en 'false' porque Meta tiene un bug conocido en cuentas sandbox: el endpoint
# lookaside.fbsbx.com devuelve 500 Internal Server Error al descargar el binary
# (paso 1 GET /v20.0/{media-id} funciona OK, paso 2 GET a lookaside falla).
# Cambiar a 'true' cuando: (a) la app pase a Live mode con Business Verification,
# (b) se use un número WhatsApp Business real (no sandbox), o (c) Meta pushee un fix.
WA_MEDIA_DOWNLOAD_ENABLED=false


# =========================
# Meta Graph API — Facebook Pages + Instagram Business
# =========================
# Signup:
#   1. Meta Business Portfolio: https://business.facebook.com
#   2. Meta App: https://developers.facebook.com/apps
#   3. Agregar casos de uso "Administrar todos los aspectos de tu página" + "Administrar mensajes y contenido en Instagram"
#   4. Crear System User (Business Settings → Users → System Users) con rol Admin
#   5. Asignar Page + IG account al System User
#   6. Generar token del System User con permisos pages_* + instagram_*
#   7. Cambiar por el Page Access Token con: GET /me/accounts?access_token=<system-user-token>
# Guía completa: docs/guia-integraciones.md#facebook-pages--meta-graph-api
META_PAGE_ID=<page-id-numérico>
META_IG_USER_ID=<instagram-business-account-id>
META_PAGE_ACCESS_TOKEN=<page-access-token-obtenido-de-/me/accounts>


# =========================
# Email inbound — Postmark
# =========================
# Signup gratis (sin tarjeta): https://account.postmarkapp.com/sign_up
# Se recibe en un email tipo <hash>@inbound.postmarkapp.com
# Guía completa: docs/guia-integraciones.md#email-inbound--postmark
# NOTA: Postmark no requiere API key en el `.env` — solo configuras el webhook URL en su panel
#       apuntando a https://<ngrok>/webhook/email-inbound
# MAIL_WEBHOOK_SIGNING_KEY=<opcional-para-verificar-firma>


# =========================
# ImgBB — host público de imágenes (Instagram lo requiere)
# =========================
# IG Content Publishing API exige URL HTTPS pública para la imagen — no acepta localhost
# ni URLs internas de Docker. ImgBB es el host más confiable para dev local.
# Signup gratis (sin tarjeta, con Google login): https://api.imgbb.com/
#   → click "Get API Key" → login → copiar la key
# Free tier: ilimitado en uploads, imágenes duran lo que definas (usamos expiration=86400 = 24h)
IMGBB_API_KEY=<tu-key-de-imgbb>
