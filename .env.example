# =========================
# PostgreSQL (shared)
# =========================
POSTGRES_USER=periodico
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=periodico
N8N_DB=n8n

# =========================
# N8N
# =========================
N8N_USER=admin
N8N_PASSWORD=changeme_n8n
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=America/Bogota

# =========================
# WordPress
# =========================
WP_DB_ROOT_PASSWORD=changeme_wp_root
WP_DB_PASSWORD=changeme_wp

# =========================
# Backoffice (Next.js)
# =========================
BACKOFFICE_PUBLIC_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme_generate_with_openssl_rand_base64_32
ADMIN_EMAIL=cliente@periodico.com
N8N_APPROVAL_WEBHOOK=http://n8n:5678/webhook/publication-approved

# =========================
# LLM — DeepSeek vía Huawei ModelArts MaaS
# =========================
# Endpoint OpenAI-compatible de Huawei ModelArts (región AP Southeast 1)
DEEPSEEK_API_URL=https://api-ap-southeast-1.modelarts-maas.com/openai/v1
# API key de Huawei Cloud (NO es formato sk-... de DeepSeek oficial)
DEEPSEEK_API_KEY=your-huawei-modelarts-key
# Nombre del modelo desplegado en Huawei (típicamente DeepSeek-V3.2 o DeepSeek-R1)
DEEPSEEK_MODEL=DeepSeek-V3.2

# =========================
# WP local — usado por scripts/import_taxonomy.py
# =========================
WP_LOCAL_URL=http://localhost:8080
WP_LOCAL_USER=admin
WP_LOCAL_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# =========================
# APIs externas (se cargan en N8N como credentials)
# Referencia — no las lee docker-compose directamente
# =========================
# WhatsApp Business Cloud API
WA_PHONE_NUMBER_ID=1045290865329291
# WA_ACCESS_TOKEN=  # ya no se usa — usamos META_PAGE_ACCESS_TOKEN que tiene el scope whatsapp_business_messaging
WA_VERIFY_TOKEN=periodico-verify-2026
# Meta Graph API (Facebook Page + Instagram Business)
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=
# WordPress (para publicar desde N8N — mismo user/app-pass o uno dedicado)
# WP_API_URL=http://wordpress/wp-json/wp/v2
# WP_APP_USER=
# WP_APP_PASSWORD=  # Application Password de WP
# Mailgun / Postmark (webhook de inbound email)
# MAIL_WEBHOOK_SIGNING_KEY=
