{
  "name": "06 Publish Instagram",
  "nodes": [
    {
      "parameters": {},
      "id": "c6a6e006-0006-4006-8006-000000000001",
      "name": "When Called by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT id, ig_caption, hashtags, image_url\nFROM publications WHERE id = '{{ $json.publicationId || $json.id }}'::uuid;",
        "options": {}
      },
      "id": "c6a6e006-0006-4006-8006-000000000002",
      "name": "Load",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [440, 300],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CRED_ID", "name": "Postgres Periodico" }
      }
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst caption = String(item.ig_caption || '').trim();\nconst hashtags = (item.hashtags || []).map(h => '#' + String(h).replace(/^#/, '').replace(/\\s+/g, '')).join(' ');\nconst fullCaption = hashtags ? `${caption}\\n\\n${hashtags}` : caption;\nreturn { ...item, full_caption: fullCaption };"
      },
      "id": "c6a6e006-0006-4006-8006-000000000003",
      "name": "Build Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Instagram descarga la imagen desde una URL publica. Usamos el propio\n// backoffice (BACKOFFICE_PUBLIC_URL debe ser https accesible desde internet).\n// Antes se subia a ImgBB, pero Meta dejo de poder descargar desde i.ibb.co.\nconst item = $input.first().json;\nconst base = String($env.BACKOFFICE_PUBLIC_URL || '').replace(/\\/$/, '');\nif (!/^https:\\/\\//.test(base)) {\n  throw new Error('BACKOFFICE_PUBLIC_URL debe ser una URL https publica para publicar en Instagram. Valor: ' + base);\n}\nconst url = base + '/api/image?path=' + encodeURIComponent(item.image_url);\nreturn { ...item, public_image_url: url };"
      },
      "id": "c6a6e006-0006-4006-8006-000000000006",
      "name": "Build Public URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.META_IG_USER_ID }}/media",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "image_url",    "value": "={{ $json.public_image_url }}" },
            { "name": "caption",      "value": "={{ $('Build Caption').item.json.full_caption }}" },
            { "name": "access_token", "value": "={{ $env.META_PAGE_ACCESS_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "c6a6e006-0006-4006-8006-000000000007",
      "name": "Create IG Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "c6a6e006-0006-4006-8006-000000000008",
      "name": "Wait 5s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1640, 300],
      "webhookId": "wait-06-ig"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.META_IG_USER_ID }}/media_publish",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "creation_id",  "value": "={{ $('Create IG Container').item.json.id }}" },
            { "name": "access_token", "value": "={{ $env.META_PAGE_ACCESS_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "c6a6e006-0006-4006-8006-000000000009",
      "name": "Publish IG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1840, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE publications\nSET ig_post_id  = '{{ String($json.id).replace(/'/g, \"''\") }}',\n    ig_post_url = 'https://www.instagram.com/p/' || '{{ String($json.id).replace(/'/g, \"''\") }}'\nWHERE id = '{{ $('When Called by Another Workflow').item.json.publicationId || $('When Called by Another Workflow').item.json.id }}'::uuid RETURNING id;",
        "options": {}
      },
      "id": "c6a6e006-0006-4006-8006-000000000010",
      "name": "Save IG IDs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2040, 300],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CRED_ID", "name": "Postgres Periodico" }
      }
    }
  ],
  "connections": {
    "When Called by Another Workflow": {
      "main": [[{ "node": "Load", "type": "main", "index": 0 }]]
    },
    "Load": {
      "main": [[{ "node": "Build Caption", "type": "main", "index": 0 }]]
    },
    "Build Caption": {
      "main": [[{ "node": "Build Public URL", "type": "main", "index": 0 }]]
    },
    "Build Public URL": {
      "main": [[{ "node": "Create IG Container", "type": "main", "index": 0 }]]
    },
    "Create IG Container": {
      "main": [[{ "node": "Wait 5s", "type": "main", "index": 0 }]]
    },
    "Wait 5s": {
      "main": [[{ "node": "Publish IG", "type": "main", "index": 0 }]]
    },
    "Publish IG": {
      "main": [[{ "node": "Save IG IDs", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": {},
  "active": false
}
