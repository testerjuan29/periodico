{
  "name": "06 Publish Instagram",
  "nodes": [
    {
      "parameters": {},
      "id": "c6a6e006-0006-4006-8006-000000000001",
      "name": "When Called by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT id, ig_caption, hashtags, image_url, wp_post_url\nFROM publications WHERE id = '{{ $json.publicationId || $json.id }}'::uuid;",
        "options": {}
      },
      "id": "c6a6e006-0006-4006-8006-000000000002",
      "name": "Load",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [440, 300],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CRED_ID", "name": "Postgres Periodico" }
      }
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst caption = String(item.ig_caption || '').trim();\nconst wpUrl = String(item.wp_post_url || '').trim();\nconst hashtags = (item.hashtags || []).map(h => '#' + String(h).replace(/^#/, '').replace(/\\s+/g, '')).join(' ');\n// Estilo editorial de PaginaUno: caption, luego \"Leer más en <enlace>\", luego hashtags.\n// En IG el enlace no es clickeable, pero el medio lo incluye igual como referencia.\nlet fullCaption = caption;\nif (wpUrl) fullCaption += `\\n\\nLeer más en ${wpUrl}`;\nif (hashtags) fullCaption += `\\n\\n${hashtags}`;\nreturn { ...item, full_caption: fullCaption };"
      },
      "id": "c6a6e006-0006-4006-8006-000000000003",
      "name": "Build Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Instagram descarga la imagen desde una URL publica. Usamos el propio\n// backoffice (BACKOFFICE_PUBLIC_URL debe ser https accesible desde internet).\n// Antes se subia a ImgBB, pero Meta dejo de poder descargar desde i.ibb.co.\nconst item = $input.first().json;\nconst base = String($env.BACKOFFICE_PUBLIC_URL || '').replace(/\\/$/, '');\nif (!/^https:\\/\\//.test(base)) {\n  throw new Error('BACKOFFICE_PUBLIC_URL debe ser una URL https publica para publicar en Instagram. Valor: ' + base);\n}\nconst url = base + '/api/image?path=' + encodeURIComponent(item.image_url);\nreturn { ...item, public_image_url: url };"
      },
      "id": "c6a6e006-0006-4006-8006-000000000006",
      "name": "Build Public URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.IMAGE_RENDERER_URL }}/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"template\": {{ JSON.stringify($env.CAROUSEL_SLIDE_TEMPLATE || 'slide-siguenos') }},\n  \"vars\": {},\n  \"width\": {{ Number($env.IMAGE_DEFAULT_WIDTH) || 1080 }},\n  \"height\": {{ Number($env.IMAGE_DEFAULT_HEIGHT) || 1350 }}\n}",
        "options": {}
      },
      "id": "c6a6e006-0006-4006-8006-000000000011",
      "name": "Render Slide",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// URL publica del slide \"Siguenos\" recien renderizado.\nconst slide = $input.first().json;\nconst base = String($env.BACKOFFICE_PUBLIC_URL || '').replace(/\\/$/, '');\nreturn {\n  slide_public_url: base + '/api/image?path=' + encodeURIComponent(slide.url),\n};"
      },
      "id": "c6a6e006-0006-4006-8006-000000000012",
      "name": "Build Slide URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.META_IG_USER_ID }}/media",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "image_url",        "value": "={{ $('Build Public URL').item.json.public_image_url }}" },
            { "name": "is_carousel_item", "value": "true" },
            { "name": "access_token",     "value": "={{ $env.META_PAGE_ACCESS_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "c6a6e006-0006-4006-8006-000000000013",
      "name": "Create Child Portada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.META_IG_USER_ID }}/media",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "image_url",        "value": "={{ $('Build Slide URL').item.json.slide_public_url }}" },
            { "name": "is_carousel_item", "value": "true" },
            { "name": "access_token",     "value": "={{ $env.META_PAGE_ACCESS_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "c6a6e006-0006-4006-8006-000000000014",
      "name": "Create Child Slide",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1640, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.META_IG_USER_ID }}/media",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "media_type",   "value": "CAROUSEL" },
            { "name": "children",     "value": "={{ $('Create Child Portada').item.json.id }},{{ $('Create Child Slide').item.json.id }}" },
            { "name": "caption",      "value": "={{ $('Build Caption').item.json.full_caption }}" },
            { "name": "access_token", "value": "={{ $env.META_PAGE_ACCESS_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "c6a6e006-0006-4006-8006-000000000015",
      "name": "Create Carousel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1840, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "id": "c6a6e006-0006-4006-8006-000000000008",
      "name": "Wait 5s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2040, 300],
      "webhookId": "wait-06-ig"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.META_IG_USER_ID }}/media_publish",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "creation_id",  "value": "={{ $('Create Carousel').item.json.id }}" },
            { "name": "access_token", "value": "={{ $env.META_PAGE_ACCESS_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "c6a6e006-0006-4006-8006-000000000009",
      "name": "Publish IG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2240, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE publications\nSET ig_post_id  = '{{ String($json.id).replace(/'/g, \"''\") }}',\n    ig_post_url = 'https://www.instagram.com/p/' || '{{ String($json.id).replace(/'/g, \"''\") }}'\nWHERE id = '{{ $('When Called by Another Workflow').item.json.publicationId || $('When Called by Another Workflow').item.json.id }}'::uuid RETURNING id;",
        "options": {}
      },
      "id": "c6a6e006-0006-4006-8006-000000000010",
      "name": "Save IG IDs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2440, 300],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CRED_ID", "name": "Postgres Periodico" }
      }
    }
  ],
