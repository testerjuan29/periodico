        "responseMode": "onReceived",
        "responseCode": 200,
        "options": {}
      },
      "id": "b2a2e002-0002-4002-8002-000000000001",
      "name": "Webhook WhatsApp",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 420],
      "webhookId": "whatsapp-inbound"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "id": "has-message",
              "leftValue": "={{ $json.body.entry?.[0]?.changes?.[0]?.value?.messages?.[0]?.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2a2e002-0002-4002-8002-000000000002",
      "name": "Is Inbound Message",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 420]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Extrae datos del mensaje WA + detecta comando LISTO.\nconst msg = $input.first().json.body.entry[0].changes[0].value.messages[0];\nconst sender = msg.from;\nconst type = msg.type;\nconst rawText = msg.text?.body || msg.image?.caption || msg.video?.caption || msg.document?.caption || '';\n\n// El mensaje es un cierre si consiste SÓLO en LISTO (con puntuación/emojis permitidos)\n// Ejemplos que matchean: 'LISTO', 'listo', 'Listo!', 'LISTO.', 'LISTO ✅'\n// Ejemplos que NO matchean: 'El acto está listo', 'LISTO para publicar'\nconst isClosing = /^\\s*listo[\\s!.✓✅👍]*$/i.test(rawText);\n\n// Si es cierre, no queremos ese texto en el buffer (sería basura)\nconst text = isClosing ? '' : rawText;\n\n// Media como array (permite acumular múltiples adjuntos entre mensajes)\nconst mediaItem = msg.image ? { type: 'image', ...msg.image }\n                : msg.video ? { type: 'video', ...msg.video }\n                : msg.document ? { type: 'document', ...msg.document }\n                : null;\nconst media = mediaItem ? [mediaItem] : [];\n\nreturn {\n  sender,\n  type,\n  text,\n  media,\n  isClosing,\n  raw: msg,\n};\n"
      },
      "id": "b2a2e002-0002-4002-8002-000000000020",
      "name": "Parse Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 420]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=WITH existing AS (\n  SELECT id FROM publications\n  WHERE source_type = 'whatsapp'\n    AND source_sender = '{{ String($json.sender).replace(/'/g, \"''\") }}'\n    AND status = 'draft'\n    AND received_at > NOW() - INTERVAL '4 hours'\n  ORDER BY received_at DESC\n  LIMIT 1\n),\nupdated AS (\n  UPDATE publications\n  SET source_text = CASE\n        WHEN COALESCE(source_text, '') = '' THEN '{{ String($json.text).replace(/'/g, \"''\") }}'\n        WHEN '{{ String($json.text).replace(/'/g, \"''\") }}' = '' THEN source_text\n        ELSE source_text || E'\\n\\n' || '{{ String($json.text).replace(/'/g, \"''\") }}'\n      END,\n      source_media = source_media || '{{ JSON.stringify($json.media).replace(/'/g, \"''\") }}'::jsonb\n  WHERE id IN (SELECT id FROM existing)\n  RETURNING id, 'appended' AS action\n),\ninserted AS (\n  INSERT INTO publications (source_type, source_raw, source_sender, source_text, source_media, status)\n  SELECT 'whatsapp',\n         '{{ JSON.stringify($('Webhook WhatsApp').item.json.body).replace(/'/g, \"''\") }}'::jsonb,\n         '{{ String($json.sender).replace(/'/g, \"''\") }}',\n         '{{ String($json.text).replace(/'/g, \"''\") }}',\n         '{{ JSON.stringify($json.media).replace(/'/g, \"''\") }}'::jsonb,\n         'draft'\n  WHERE NOT EXISTS (SELECT 1 FROM existing)\n    AND ({{ $json.isClosing ? 'false' : 'true' }})\n  RETURNING id, 'created' AS action\n)\nSELECT id, action FROM updated\nUNION ALL\nSELECT id, action FROM inserted;",
        "options": {}
      },
      "id": "b2a2e002-0002-4002-8002-000000000004",
      "name": "Upsert Draft",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [900, 420],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CRED_ID", "name": "Postgres Periodico" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "id": "is-closing-and-has-draft",
              "leftValue": "={{ $('Parse Message').item.json.isClosing && $json.id }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2a2e002-0002-4002-8002-000000000021",
      "name": "Is Closing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1120, 420]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE publications SET status = 'pending' WHERE id = '{{ $json.id }}'::uuid AND status = 'draft' RETURNING id;",
        "options": {}
      },
      "id": "b2a2e002-0002-4002-8002-000000000022",
      "name": "Close Draft",
