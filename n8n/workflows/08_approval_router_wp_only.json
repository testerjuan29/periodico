{
  "name": "08 Approval Router (WP only)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "publication-approved",
        "responseMode": "onReceived",
        "responseCode": 200,
        "options": {}
      },
      "id": "c8a8e008-0008-4008-8008-000000000001",
      "name": "Webhook Approval",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "publication-approved"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "publicationId", "value": "={{ $json.body?.publicationId || $json.publicationId }}", "type": "string" },
            { "id": "2", "name": "event",         "value": "={{ $json.body?.event || $json.event || 'approved' }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "c8a8e008-0008-4008-8008-000000000002",
      "name": "Extract",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "id": "is-approved-now",
              "leftValue": "={{ $json.event }}",
              "rightValue": "approved",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c8a8e008-0008-4008-8008-000000000003",
      "name": "Publish Now?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE publications SET status='publishing' WHERE id='{{ $json.publicationId }}'::uuid RETURNING id;",
        "options": {}
      },
      "id": "c8a8e008-0008-4008-8008-000000000004",
      "name": "Mark Publishing",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [960, 220],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CRED_ID", "name": "Postgres Periodico" }
      }
    },
    {
      "parameters": {
        "workflowId": { "__rl": true, "mode": "name", "value": "04 Publish WordPress" },
        "options": {}
      },
      "id": "c8a8e008-0008-4008-8008-000000000005",
      "name": "→ WordPress",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1200, 220]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE publications\nSET status = 'published',\n    published_at = NOW()\nWHERE id = '{{ $('Extract').item.json.publicationId }}'::uuid\nRETURNING id, status;",
        "options": {}
      },
      "id": "c8a8e008-0008-4008-8008-000000000006",
      "name": "Mark Published",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1440, 220],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CRED_ID", "name": "Postgres Periodico" }
      }
    }
  ],
  "connections": {
    "Webhook Approval": {
      "main": [[{ "node": "Extract", "type": "main", "index": 0 }]]
    },
    "Extract": {
      "main": [[{ "node": "Publish Now?", "type": "main", "index": 0 }]]
    },
    "Publish Now?": {
      "main": [
        [{ "node": "Mark Publishing", "type": "main", "index": 0 }],
        []
      ]
    },
    "Mark Publishing": {
      "main": [[{ "node": "→ WordPress", "type": "main", "index": 0 }]]
    },
    "→ WordPress": {
      "main": [[{ "node": "Mark Published", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": {},
  "active": false
}
