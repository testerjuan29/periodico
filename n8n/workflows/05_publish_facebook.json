{
  "name": "05 Publish Facebook",
  "nodes": [
    {
      "parameters": {},
      "id": "c5a5e005-0005-4005-8005-000000000001",
      "name": "When Called by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT id, fb_caption, image_url, wp_post_url\nFROM publications WHERE id = '{{ $json.publicationId || $json.id }}'::uuid;",
        "options": {}
      },
      "id": "c5a5e005-0005-4005-8005-000000000002",
      "name": "Load",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [440, 300],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CRED_ID", "name": "Postgres Periodico" }
      }
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst caption = String(item.fb_caption || '').trim();\nconst wpUrl = String(item.wp_post_url || '').trim();\nconst fullCaption = wpUrl ? `${caption}\\n\\n📰 Nota completa: ${wpUrl}` : caption;\nreturn { ...item, full_caption: fullCaption };"
      },
      "id": "c5a5e005-0005-4005-8005-000000000003",
      "name": "Build Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://backoffice:3000/api/image?path={{ encodeURIComponent($json.image_url) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "c5a5e005-0005-4005-8005-000000000004",
      "name": "Download Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.META_PAGE_ID }}/photos",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "caption", "value": "={{ $('Build Caption').item.json.full_caption }}" },
            { "name": "access_token", "value": "={{ $env.META_PAGE_ACCESS_TOKEN }}" },
            { "parameterType": "formBinaryData", "name": "source", "inputDataFieldName": "data" }
          ]
        },
        "options": {}
      },
      "id": "c5a5e005-0005-4005-8005-000000000005",
      "name": "Publish to FB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE publications\nSET fb_post_id = '{{ String($json.post_id || $json.id).replace(/'/g, \"''\") }}',\n    fb_post_url = 'https://www.facebook.com/' || '{{ String($json.post_id || $json.id).replace(/'/g, \"''\") }}'\nWHERE id = '{{ $('When Called by Another Workflow').item.json.publicationId || $('When Called by Another Workflow').item.json.id }}'::uuid RETURNING id;",
        "options": {}
      },
      "id": "c5a5e005-0005-4005-8005-000000000006",
      "name": "Save FB IDs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1240, 300],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CRED_ID", "name": "Postgres Periodico" }
      }
    }
  ],
  "connections": {
    "When Called by Another Workflow": {
      "main": [[{ "node": "Load", "type": "main", "index": 0 }]]
    },
    "Load": {
      "main": [[{ "node": "Build Caption", "type": "main", "index": 0 }]]
    },
    "Build Caption": {
      "main": [[{ "node": "Download Image", "type": "main", "index": 0 }]]
    },
    "Download Image": {
      "main": [[{ "node": "Publish to FB", "type": "main", "index": 0 }]]
    },
    "Publish to FB": {
      "main": [[{ "node": "Save FB IDs", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": {},
  "active": false
}
