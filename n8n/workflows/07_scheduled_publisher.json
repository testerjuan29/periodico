{
  "name": "07 Scheduled Publisher",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 1 }] }
      },
      "id": "b7a7e007-0007-4007-8007-000000000001",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE publications\nSET status = 'publishing'\nWHERE id IN (\n  SELECT id FROM publications\n  WHERE status = 'scheduled' AND scheduled_at <= NOW()\n  ORDER BY scheduled_at\n  LIMIT 20\n  FOR UPDATE SKIP LOCKED\n)\nRETURNING id;",
        "options": {}
      },
      "id": "b7a7e007-0007-4007-8007-000000000002",
      "name": "Claim Due",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [480, 300],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CRED_ID", "name": "Postgres Periodico" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has-id",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b7a7e007-0007-4007-8007-000000000010",
      "name": "Has Due Row?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/publication-approved",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { publicationId: $json.id, event: 'approved' } }}",
        "options": {}
      },
      "id": "b7a7e007-0007-4007-8007-000000000003",
      "name": "Notify 08 via Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 260]
    }
  ],
  "connections": {
    "Every Minute": {
      "main": [[{ "node": "Claim Due", "type": "main", "index": 0 }]]
    },
    "Claim Due": {
      "main": [[{ "node": "Has Due Row?", "type": "main", "index": 0 }]]
    },
    "Has Due Row?": {
      "main": [
        [{ "node": "Notify 08 via Webhook", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": {},
  "active": false
}
